{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the Festive Curator app.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique ID of the user." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "displayName": { "type": "string", "description": "The user's display name." },
        "photoURL": { "type": "string", "format": "uri", "description": "The user's profile photo URL." }
      },
      "required": ["uid", "email"]
    },
    "Draft": {
      "title": "Draft",
      "description": "A saved draft of a digital gift card.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The ID of the user who created the draft." },
        "templateId": { "type": "string", "description": "The ID of the template used." },
        "customization": {
          "type": "object",
          "properties": {
            "message": { "type": "string" },
            "font": { "type": "string" },
            "photos": { "type": "array", "items": { "type": "string" } },
            "layout": { "type": "string" },
            "recipientName": { "type": "string" },
            "recipientEmail": { "type": "string" },
            "deliveryDate": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "templateId", "customization"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data."
    },
    "/users/{userId}/drafts/{draftId}": {
      "schema": "Draft",
      "description": "User's saved gift card drafts."
    }
  }
}
